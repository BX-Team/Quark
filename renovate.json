{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>BX-Team/.github//renovate/gradle"],
  "packageRules": [
    {
      "description": "Server APIs and Shadow are compileOnly compatibility floors: raising them drops support for older servers and builds.",
      "matchPackageNames": [
        "org.spigotmc:spigot-api",
        "io.papermc.paper:paper-api",
        "com.velocitypowered:velocity-api",
        "com.gradleup.shadow:shadow-gradle-plugin"
      ],
      "enabled": false
    }
  ]
}
